{
  "datasets": [
    {
      "name": "ds_kpis",
      "displayName": "KPIs Mercado",
      "queryLines": [
        "SELECT ",
        "    data_referencia, ",
        "    ROUND(valor_mercado_total_usd / 1e12, 2) AS market_cap_tri_usd, ",
        "    ROUND(volume_total_usd / 1e9, 2) AS volume_bi_usd, ",
        "    ROUND(top_valor_mercado_usd * 1.0 / valor_mercado_total_usd, 4) AS btc_dominance, ",
        "    qtd_moedas ",
        "FROM coingecko.gold.gold_resumo_mercado_diario ",
        "ORDER BY data_referencia DESC ",
        "LIMIT 1 "
      ]
    },
    {
      "name": "ds_serie_mercado",
      "displayName": "Série Histórica 90 Dias",
      "queryLines": [
        "SELECT ",
        "    data_referencia, ",
        "    ROUND(valor_mercado_total_usd / 1e12, 2) AS market_cap_tri_usd, ",
        "    ROUND(volume_total_usd / 1e9, 2) AS volume_bi_usd ",
        "FROM coingecko.gold.gold_resumo_mercado_diario ",
        "WHERE data_referencia >= date_sub(current_date(), 90) ",
        "ORDER BY data_referencia "
      ]
    },
    {
      "name": "ds_ranking_hoje",
      "displayName": "Ranking Hoje Top 10",
      "queryLines": [
        "SELECT ",
        "    rank_valor_mercado AS ranking, ",
        "    nome_moeda, ",
        "    simbolo, ",
        "    ROUND(preco_medio_usd, 2) AS preco_usd, ",
        "    ROUND(valor_mercado_medio_usd / 1e9, 2) AS market_cap_bi_usd, ",
        "    ROUND(volume_medio_usd / 1e9, 2) AS volume_bi_usd ",
        "FROM coingecko.gold.gold_ranking_moedas_diario ",
        "WHERE data_referencia = (SELECT MAX(data_referencia) FROM coingecko.gold.gold_ranking_moedas_diario) ",
        "ORDER BY rank_valor_mercado ",
        "LIMIT 10 "
      ]
    },
    {
      "name": "ds_variacao_hoje",
      "displayName": "Variação D1 Hoje",
      "queryLines": [
        "SELECT ",
        "    nome_moeda, ",
        "    simbolo, ",
        "    ROUND(preco_medio_usd, 4) AS preco_usd, ",
        "    ROUND(variacao_pct_d1, 2) AS variacao_pct, ",
        "    ROUND(variacao_abs_d1_usd, 4) AS variacao_abs_usd, ",
        "    CASE WHEN variacao_pct_d1 >= 0 THEN 'Alta' ELSE 'Baixa' END AS direcao ",
        "FROM coingecko.gold.gold_variacao_preco_d1 ",
        "WHERE data_referencia = (SELECT MAX(data_referencia) FROM coingecko.gold.gold_variacao_preco_d1) ",
        "  AND variacao_pct_d1 IS NOT NULL ",
        "ORDER BY variacao_pct_d1 DESC "
      ]
    },
    {
      "name": "ds_top_gainers",
      "displayName": "Top 8 Altas do Dia",
      "queryLines": [
        "SELECT ",
        "    nome_moeda, ",
        "    ROUND(variacao_pct_d1, 2) AS variacao_pct ",
        "FROM coingecko.gold.gold_variacao_preco_d1 ",
        "WHERE data_referencia = (SELECT MAX(data_referencia) FROM coingecko.gold.gold_variacao_preco_d1) ",
        "  AND variacao_pct_d1 IS NOT NULL ",
        "ORDER BY variacao_pct_d1 DESC ",
        "LIMIT 8 "
      ]
    },
    {
      "name": "ds_top_losers",
      "displayName": "Top 8 Quedas do Dia",
      "queryLines": [
        "SELECT ",
        "    nome_moeda, ",
        "    ROUND(variacao_pct_d1, 2) AS variacao_pct ",
        "FROM coingecko.gold.gold_variacao_preco_d1 ",
        "WHERE data_referencia = (SELECT MAX(data_referencia) FROM coingecko.gold.gold_variacao_preco_d1) ",
        "  AND variacao_pct_d1 IS NOT NULL ",
        "ORDER BY variacao_pct_d1 ASC ",
        "LIMIT 8 "
      ]
    },
    {
      "name": "ds_historico_top",
      "displayName": "Top 8 Valorizações Históricas",
      "queryLines": [
        "SELECT nome_moeda, ROUND(variacao_percentual_total, 1) AS variacao_pct_total ",
        "FROM coingecko.gold.gold_resumo_moeda ",
        "WHERE qtd_dias_com_dados >= 30 ",
        "  AND variacao_percentual_total > 0 ",
        "ORDER BY variacao_percentual_total DESC ",
        "LIMIT 8 "
      ]
    },
    {
      "name": "ds_historico_bot",
      "displayName": "Top 8 Quedas Históricas",
      "queryLines": [
        "SELECT nome_moeda, ROUND(variacao_percentual_total, 1) AS variacao_pct_total ",
        "FROM coingecko.gold.gold_resumo_moeda ",
        "WHERE qtd_dias_com_dados >= 30 ",
        "  AND variacao_percentual_total < -5 ",
        "ORDER BY variacao_percentual_total ASC ",
        "LIMIT 8 "
      ]
    },
    {
      "name": "ds_historico_moedas",
      "displayName": "Histórico por Moeda",
      "queryLines": [
        "SELECT ",
        "    nome_moeda, ",
        "    simbolo, ",
        "    ROUND(preco_primeiro_dia_usd, 4) AS preco_inicio_usd, ",
        "    ROUND(preco_ultimo_dia_usd, 4) AS preco_atual_usd, ",
        "    ROUND(variacao_percentual_total, 1) AS variacao_pct_total, ",
        "    ROUND(valor_mercado_ultimo_dia_bi_usd, 2) AS market_cap_bi_usd, ",
        "    qtd_dias_com_dados ",
        "FROM coingecko.gold.gold_resumo_moeda ",
        "WHERE qtd_dias_com_dados >= 30 ",
        "ORDER BY variacao_percentual_total DESC "
      ]
    }
  ],
